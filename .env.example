APP_NAME=ARJUNA AI
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:8080

# Console authentication. Put production values in a secret manager.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
API_KEY_HASH_SECRET=replace-with-at-least-32-random-characters
PROVIDER_VAULT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# Local default. For production use a persistent PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./data/arjuna.db
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=8
REQUEST_TIMEOUT_SECONDS=90
PROVIDER_FAILURE_COOLDOWN_SECONDS=60
# Keep false for a zero-spend platform. Paid routes require an explicit operator opt-in.
ALLOW_PAID_ROUTES=false

# Optional bootstrap API key(s), comma separated. Generated keys can also be issued in the console.
PLATFORM_API_KEYS=replace-with-a-long-random-key

# FREE_ELIGIBLE is your policy flag. Only enable when that key/account has free quota you accept.
NVIDIA_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIORITY=10
NVIDIA_FREE_ELIGIBLE=true
NVIDIA_ALLOWED_MODELS=
NVIDIA_FREE_MODELS=

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_PRIORITY=20
GEMINI_FREE_ELIGIBLE=true
GEMINI_ALLOWED_MODELS=
GEMINI_FREE_MODELS=

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIORITY=30
GROQ_FREE_ELIGIBLE=true
GROQ_ALLOWED_MODELS=
GROQ_FREE_MODELS=

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIORITY=40
OPENROUTER_FREE_ELIGIBLE=false
OPENROUTER_ALLOWED_MODELS=
OPENROUTER_FREE_MODELS=

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRIORITY=50
OPENAI_FREE_ELIGIBLE=false
OPENAI_ALLOWED_MODELS=
OPENAI_FREE_MODELS=
