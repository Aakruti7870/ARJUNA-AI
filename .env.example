APP_NAME=ARJUNA AI
APP_ENV=development

# Your ARJUNA AI platform API key(s). Use long random values in production.
PLATFORM_API_KEYS=dev-local-key
PUBLIC_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=90
PROVIDER_FAILURE_COOLDOWN_SECONDS=60

# IMPORTANT: "FREE_ELIGIBLE" is YOUR policy flag. Set it true only when
# the account/key currently has free quota you are willing to use.

NVIDIA_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PRIORITY=10
NVIDIA_FREE_ELIGIBLE=true

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_PRIORITY=20
GEMINI_FREE_ELIGIBLE=true

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIORITY=30
GROQ_FREE_ELIGIBLE=true

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIORITY=40
OPENROUTER_FREE_ELIGIBLE=false

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PRIORITY=50
OPENAI_FREE_ELIGIBLE=false
